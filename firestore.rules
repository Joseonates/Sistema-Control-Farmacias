rules_version = '2';

// =====================================================================
// MOSTRADOR · Reglas de seguridad de Firestore
// Plataforma multi-droguería. Cada droguería vive en /tenants/{t} y su
// información en subcolecciones. El rol de cada persona se guarda en
// /tenants/{t}/members/{uid} (no en el token), para funcionar en el
// plan gratuito sin Cloud Functions.
//
// Roles: admin (dueño/administrador), regente, vendedor.
// Estados de la droguería: prueba (30 días desde su creación),
// activa, suspendida. Solo el dueño de la plataforma (/superadmins)
// cambia el estado.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- utilidades ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function tPath(t) { return /databases/$(database)/documents/tenants/$(t); }
    function sub(t, col, id) { return /databases/$(database)/documents/tenants/$(t)/$(col)/$(id); }
    function mPath(t) { return sub(t, 'members', request.auth.uid); }
    function isSuper() { return signedIn() && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid)); }

    // La droguería puede operar si está activa o dentro de sus 30 días de prueba.
    function tenantActivo(t) {
      let d = get(tPath(t)).data;
      return d.estado == 'activa'
        || (d.estado == 'prueba' && request.time < d.creado + duration.value(30, 'd'));
    }
    function isMember(t) {
      return signedIn() && exists(mPath(t)) && get(mPath(t)).data.activo == true && tenantActivo(t);
    }
    function hasRole(t, roles) { return isMember(t) && get(mPath(t)).data.rol in roles; }
    function isAdmin(t) { return hasRole(t, ['admin']); }
    function isStaff(t) { return hasRole(t, ['admin', 'regente']); }

    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function nonNegInt(v) { return v is int && v >= 0; }
    function nonNegNum(v) { return (v is int || v is float) && v >= 0; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function txt(v) { return v is string && v.size() > 0 && v.size() <= 300; }

    // Registro de una droguería nueva: el mismo lote de escrituras crea
    // la droguería con ownerUid = quien se registra.
    function bootstrap(t) {
      return signedIn() && !exists(tPath(t)) && getAfter(tPath(t)).data.ownerUid == request.auth.uid;
    }

    // ---------- dueño de la plataforma ----------
    match /superadmins/{u} {
      allow read: if signedIn() && u == me();
      allow write: if false; // se crea a mano en la consola de Firebase
    }

    // Cada persona puede ver sus propias membresías (para saber a qué droguerías entra).
    match /{path=**}/members/{m} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    // ---------- droguería ----------
    match /tenants/{t} {
      allow get: if signedIn() && (exists(mPath(t)) || isSuper());
      allow list: if isSuper();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['info', 'config', 'ownerUid', 'estado', 'creado'])
        && request.resource.data.ownerUid == me()
        && request.resource.data.estado == 'prueba'
        && request.resource.data.creado == request.time
        && txt(request.resource.data.info.nombre)
        && validConfig()
        && existsAfter(mPath(t));
      allow update: if (isAdmin(t) && changedOnly(['info', 'config']) && txt(request.resource.data.info.nombre) && validConfig())
        || (isSuper() && changedOnly(['estado', 'notaPlataforma'])
            && request.resource.data.estado in ['prueba', 'activa', 'suspendida']);
      allow delete: if false;

      function validConfig() {
        let c = request.resource.data.config;
        return c.rojoMeses is int && c.amarilloMeses is int
          && c.rojoMeses >= 1 && c.amarilloMeses > c.rojoMeses && c.amarilloMeses <= 36
          && c.prefijo is string && c.prefijo.size() >= 1 && c.prefijo.size() <= 4;
      }

      // ----- personas y roles -----
      match /members/{m} {
        allow read: if isMember(t) || isSuper();
        allow create: if validMember(m) && (
          (isAdmin(t) && m != me())
          || (bootstrap(t) && m == me() && request.resource.data.rol == 'admin' && request.resource.data.activo == true));
        allow update: if isAdmin(t) && validMember(m)
          // nadie se quita a sí mismo el rol de administrador ni se desactiva
          && !(m == me() && (request.resource.data.rol != 'admin' || request.resource.data.activo != true))
          // el dueño de la droguería siempre sigue siendo administrador activo
          && !(m == get(tPath(t)).data.ownerUid && (request.resource.data.rol != 'admin' || request.resource.data.activo != true));
        allow delete: if false; // se desactivan, no se borran

        function validMember(m) {
          let d = request.resource.data;
          return d.uid == m && d.rol in ['admin', 'regente', 'vendedor'] && d.activo is bool
            && txt(d.nombre) && d.email is string;
        }
      }

      // ----- catálogo -----
      match /productos/{p} {
        allow read: if isMember(t);
        allow create, update: if isStaff(t) && validProducto();
        allow delete: if isStaff(t);

        function validProducto() {
          let d = request.resource.data;
          return txt(d.nombre) && d.tipo in ['libre', 'formula', 'control']
            && d.upc is int && d.upc >= 1 && d.fracc is bool
            && nonNegNum(d.precioCaja) && nonNegNum(d.precioUnidad)
            && d.iva in [0, 5, 19] && nonNegNum(d.stockMin);
        }
      }

      match /proveedores/{p} {
        allow read: if isMember(t);
        allow create, update: if isStaff(t) && txt(request.resource.data.nombre);
        allow delete: if false;
      }

      // ----- entradas de mercancía -----
      match /compras/{c} {
        allow read: if isMember(t);
        allow create: if isStaff(t) && request.resource.data.userId == me()
          && txt(request.resource.data.factura) && request.resource.data.lineas is list
          && request.resource.data.lineas.size() > 0 && nonNegNum(request.resource.data.total);
        allow update, delete: if false;
      }

      // ----- inventario por lote -----
      match /lotes/{l} {
        allow read: if isMember(t);
        allow create: if isStaff(t) && validLote();
        allow update:
          // regente o administrador: compras, bajas, anulaciones y ventas
          if (isStaff(t) && changedOnly(['cant', 'costoU', 'ultimoMov'])
              && nonNegInt(request.resource.data.cant) && nonNegNum(request.resource.data.costoU))
          // vendedor: solo puede descontar unidades dentro de una venta nueva
          || (isMember(t) && changedOnly(['cant', 'ultimoMov'])
              && nonNegInt(request.resource.data.cant)
              && request.resource.data.cant < resource.data.cant
              && !exists(sub(t, 'ventas', request.resource.data.ultimoMov))
              && existsAfter(sub(t, 'ventas', request.resource.data.ultimoMov)));
        allow delete: if false;

        function validLote() {
          let d = request.resource.data;
          return d.pid is string && txt(d.lote) && isDate(d.vence) && isDate(d.ingreso)
            && nonNegInt(d.cant) && nonNegNum(d.costoU) && d.compraId is string;
        }
      }

      match /bajas/{b} {
        allow read: if isMember(t);
        allow create: if isStaff(t) && request.resource.data.userId == me()
          && request.resource.data.cant is int && request.resource.data.cant > 0 && txt(request.resource.data.motivo);
        allow update, delete: if false;
      }

      // ----- ventas -----
      match /ventas/{v} {
        allow read: if isMember(t);
        allow create: if isMember(t) && validVenta();
        // anular: solo regente o administrador, una sola vez
        allow update: if isStaff(t) && changedOnly(['anulada'])
          && resource.data.anulada == false && request.resource.data.anulada.userId == me();
        allow delete: if false;

        function validVenta() {
          let d = request.resource.data;
          let cnt = sub(t, 'contadores', 'ventas');
          return d.userId == me() && d.anulada == false
            && d.consecutivo is int
            && get(cnt).data.n == d.consecutivo - 1
            && getAfter(cnt).data.n == d.consecutivo
            && d.cajaId is string
            && get(sub(t, 'cajas', d.cajaId)).data.cierre == null
            && d.items is list && d.items.size() > 0 && d.items.size() <= 100
            && nonNegNum(d.total) && isDate(d.dia);
        }
      }

      // Consecutivo de ventas: solo puede subir de uno en uno.
      match /contadores/{c} {
        allow read: if isMember(t);
        allow create: if (bootstrap(t) || isAdmin(t)) && request.resource.data.n == 0;
        allow update: if isMember(t) && changedOnly(['n']) && request.resource.data.n == resource.data.n + 1;
        allow delete: if false;
      }

      // ----- caja: una sola caja abierta a la vez por droguería -----
      match /estado/{e} {
        allow read: if isMember(t);
        allow create: if (bootstrap(t) || isAdmin(t)) && e == 'caja' && request.resource.data.abiertaId == null;
        allow update: if isMember(t) && e == 'caja' && changedOnly(['abiertaId']) && (
          // abrir
          (resource.data.abiertaId == null && request.resource.data.abiertaId is string
            && !exists(sub(t, 'cajas', request.resource.data.abiertaId))
            && existsAfter(sub(t, 'cajas', request.resource.data.abiertaId)))
          // cerrar
          || (resource.data.abiertaId != null && request.resource.data.abiertaId == null
            && getAfter(sub(t, 'cajas', resource.data.abiertaId)).data.cierre != null));
        allow delete: if false;
      }

      match /cajas/{c} {
        allow read: if isMember(t);
        allow create: if isMember(t) && request.resource.data.userId == me()
          && request.resource.data.cierre == null && nonNegNum(request.resource.data.base)
          && get(sub(t, 'estado', 'caja')).data.abiertaId == null
          && getAfter(sub(t, 'estado', 'caja')).data.abiertaId == c;
        allow update: if isMember(t) && resource.data.cierre == null && changedOnly(['cierre'])
          && request.resource.data.cierre.userId == me()
          && getAfter(sub(t, 'estado', 'caja')).data.abiertaId == null;
        allow delete: if false;
      }
    }
  }
}
